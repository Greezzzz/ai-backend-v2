{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "Health & Reliability",
  "uid": "health-reliability",
  "tags": [
    "ai-backend",
    "health"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape target up",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "max": 1,
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "up{job=\"ai-backend-v2\"}",
          "refId": "A"
        }
      ],
      "description": "1 = Prometheus bisa reach app. 0 = app mati / port beda. Cek ini dulu kalau semua panel kosong."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Retry attempts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(retry_attempts_total[5m])) by (operation)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "description": "Laju percobaan ulang panggilan (LLM/embedding). Naik = provider tidak stabil."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retry exhausted",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(retry_exhausted_total[5m])) by (operation)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "description": "Retry habis = request gagal total. Ini sumber error 5xx."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate limiter tokens available",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "rate_limiter_tokens_available",
          "refId": "A"
        }
      ],
      "description": "Sisa token bucket internal. 0 = semua request LLM antri/tertahan (kita throttle sendiri)."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "4xx error rate",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_total{status_code=~\"4..\",path!=\"/metrics\"}[5m])) by (path)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "description": "Laju error klien (400/401/404) per endpoint. Naik mendadak = bug klien / salah panggil API."
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
