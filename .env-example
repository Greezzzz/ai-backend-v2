# ============================================================
# Contoh konfigurasi environment untuk ai-backend-v2
#
# Cara pakai:
#   1. Salin file ini menjadi `.env`:  cp .env-example .env
#   2. Isi nilai sesuai environment kamu (jangan commit .env!)
#   3. Semua variabel dibaca runtime lewat pydantic-settings,
#      tidak ada kode yang membaca file ini secara langsung.
# ============================================================

# ------------------------------------------------------------
# OpenAI-compatible LLM provider
# ------------------------------------------------------------

# API key provider kamu (OpenAI / DeepSeek / provider OpenAI-compatible lain)
OPENAI_API_KEY=sk-xxxx

# Model default yang dipakai OpenAIClient untuk request chat.
# Catatan: ini berbeda dari registry model (deepseek-v4-flash) di
# features/chat/dependencies.py — keduanya bisa sama atau berbeda.
OPENAI_MODEL=deepseek-v4-flash

# Base URL provider.
# PENTING: jangan diakhiri /v1 — client otomatis menambahkan
# /v1/chat/completions. Contoh:
#   OpenAI  -> https://api.openai.com
#   DeepSeek-> https://api.deepseek.com
#   Local   -> http://localhost:11434  (ollama, dsb)
OPENAI_BASE_URL=https://api.openai.com

# Parameter chat default (dipakai OpenAIClient jika tidak dari ModelProfile)
OPENAI_TEMP=0.7
OPENAI_MAX_TOKEN=1024

# ------------------------------------------------------------
# HTTP client (httpx.AsyncClient) — timeout & connection pool
# ------------------------------------------------------------

OPENAI_CONN_TIMEOUT=10
OPENAI_WRITE_TIMEOUT=30
OPENAI_READ_TIMEOUT=30
OPENAI_POOL_TIMEOUT=30
OPENAI_MAX_CONNECTIONS=100
OPENAI_MAX_KEEPALIVE_CONNECTIONS=20
OPENAI_KEEP_ALIVE_EXPIRY=30

# ------------------------------------------------------------
# Retry policy (exponential backoff + jitter)
# ------------------------------------------------------------

OPENAI_RETRY_MAX_ATTEMPT=3
OPENAI_RETRY_BASE_DELAY=0.5
OPENAI_RETRY_MULTIPLIER=2.0
OPENAI_RETRY_MAX_DELAY=8.0
OPENAI_RETRY_ENABLE_JITTER=true

# ------------------------------------------------------------
# Rate limiter (token bucket) untuk panggilan LLM
# ------------------------------------------------------------

OPENAI_RATE_LIMIT_CAPACITY=10
OPENAI_RATE_LIMIT_REFILL_PER_SECOND=2
OPENAI_RATE_LIMIT_ACQUIRE_TIMEOUT=5

# ------------------------------------------------------------
# PostgreSQL (SQLAlchemy async + asyncpg + Alembic)
# ------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_backend_v2

# ------------------------------------------------------------
# Auth — JWT (untuk endpoint /api) & API key (untuk /metrics)
# ------------------------------------------------------------

# Secret untuk menandatangani JWT. WAJIB ganti dengan string acak panjang
# di production (misal hasil `openssl rand -hex 32`).
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Algoritma JWT (HS256 standar).
JWT_ALGORITHM=HS256

# Umur token akses dalam menit.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API key statis untuk melindungi endpoint /metrics (dikirim via header X-API-Key).
API_KEY=change-me-metrics-key

# ------------------------------------------------------------
# HTTP rate limit (in-memory, per client IP) — berlaku semua endpoint
# ------------------------------------------------------------

HTTP_RATE_LIMIT_REQUESTS_PER_MINUTE=60
