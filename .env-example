# ============================================================
# Contoh konfigurasi environment untuk ai-backend-v2
#
# Cara pakai:
#   1. Salin file ini menjadi `.env`:  cp .env-example .env
#   2. Isi nilai sesuai environment kamu (jangan commit .env!)
#   3. Semua variabel dibaca runtime lewat pydantic-settings,
#      tidak ada kode yang membaca file ini secara langsung.
# ============================================================

# ------------------------------------------------------------
# OpenAI-compatible LLM provider
# ------------------------------------------------------------

# API key provider kamu (OpenAI / DeepSeek / provider OpenAI-compatible lain)
CHAT_API_KEY=sk-xxxx

# Provider yang dipakai untuk chat. Menentukan client, tokenizer, dan retry
# policy yang digunakan. Nilai saat ini: openai | anthropic.
CHAT_PROVIDER=openai

# Model default yang dipakai request chat & streaming.
# Satu sumber kebenaran: model ini juga yang dipakai untuk resolve
# token counter / context budget (bukan lagi hardcode di registry).
CHAT_MODEL=deepseek-v4-flash

# Context window model (token) — batas maksimal input yang bisa masuk ke
# request AI. Menentukan seberapa banyak history/RAG yang bisa ditambahkan.
CHAT_CONTEXT_WINDOW=128000

# Batas output token yang diminta ke API (max_tokens di payload).
CHAT_MAX_OUTPUT_TOKENS=4096

# Koreksi bias tokenizer lokal vs aktual input token provider.
# DeepSeek-V4: tokenizer lokal selalu undercount 79 token per request
# (konstan, sudah dites dengan history). Set 0 kalau model tidak punya bias.
CHAT_TOKEN_CORRECTION=79

# Base URL provider.
# PENTING: jangan diakhiri /v1 — client otomatis menambahkan
# /v1/chat/completions. Contoh:
#   OpenAI  -> https://api.openai.com
#   DeepSeek-> https://api.deepseek.com
#   Local   -> http://localhost:11434  (ollama, dsb)
CHAT_BASE_URL=https://api.openai.com

# Parameter chat default (dipakai OpenAIClient jika tidak dari ModelProfile)
CHAT_TEMP=0.7

# ------------------------------------------------------------
# HTTP client (httpx.AsyncClient) — timeout & connection pool
# ------------------------------------------------------------

CHAT_CONN_TIMEOUT=10
CHAT_WRITE_TIMEOUT=30
CHAT_READ_TIMEOUT=30
# Timeout read KHUSUS streaming (antar-chunk). Lebih longgar dari read biasa:
# model reasoning bisa diam lama sebelum token pertama / jeda antar-chunk.
CHAT_STREAM_READ_TIMEOUT=300
CHAT_POOL_TIMEOUT=30
CHAT_MAX_CONNECTIONS=100
CHAT_MAX_KEEPALIVE_CONNECTIONS=20
CHAT_KEEP_ALIVE_EXPIRY=30

# ------------------------------------------------------------
# Retry policy (exponential backoff + jitter)
# ------------------------------------------------------------

CHAT_RETRY_MAX_ATTEMPT=3
CHAT_RETRY_BASE_DELAY=0.5
CHAT_RETRY_MULTIPLIER=2.0
CHAT_RETRY_MAX_DELAY=8.0
CHAT_RETRY_ENABLE_JITTER=true

# ------------------------------------------------------------
# Rate limiter (token bucket) untuk panggilan LLM
# ------------------------------------------------------------

CHAT_RATE_LIMIT_CAPACITY=10
CHAT_RATE_LIMIT_REFILL_PER_SECOND=2
CHAT_RATE_LIMIT_ACQUIRE_TIMEOUT=5

# ------------------------------------------------------------
# PostgreSQL (SQLAlchemy async + asyncpg + Alembic)
# ------------------------------------------------------------

# PENTING (deploy docker compose): kalau app jalan di container, isi dengan
# NAMA SERVICE, bukan localhost:
#   DB_HOST=postgres
#   DB_PORT=5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_backend_v2

# ------------------------------------------------------------
# Auth — JWT (untuk endpoint /api) & API key (untuk /metrics)
# ------------------------------------------------------------

# Secret untuk menandatangani JWT. WAJIB ganti dengan string acak panjang
# di production (misal hasil `openssl rand -hex 32`).
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Algoritma JWT (HS256 standar).
JWT_ALGORITHM=HS256

# Umur token akses dalam menit.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Umur refresh token dalam menit (rotasi session; TTL session di Redis).
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=60

# API key statis untuk melindungi endpoint /metrics (dikirim via header X-API-Key).
API_KEY=change-me-metrics-key

# ------------------------------------------------------------
# HTTP rate limit (in-memory, per client IP) — berlaku semua endpoint
# ------------------------------------------------------------

HTTP_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------
# Redis — queue background job (RQ) & (nantinya) cache
# ------------------------------------------------------------

# Deploy docker compose: REDIS_URL=redis://redis:6380/0 (nama service).
REDIS_URL=redis://localhost:6380/0

# ------------------------------------------------------------
# Embedding (RAG) — OpenAI text-embedding-3-small (1536 dim)
# ------------------------------------------------------------

# API key OpenAI untuk embedding (bisa beda dari CHAT_API_KEY).
EMBEDDING_API_KEY=sk-xxxx

# Model embedding & dimensi vektor.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Base URL opsional untuk endpoint OpenAI-compatible (kosongkan = api.openai.com).
EMBEDDING_BASE_URL=

# ------------------------------------------------------------
# OpenTelemetry (tracing) — default mati. Nyalakan + arahkan ke collector
# (Jaeger / OTel Collector / Grafana Tempo) untuk lihat trace di UI.
# ------------------------------------------------------------

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-backend-v2
